# Copy to .env (local). Never commit .env.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: only if supabase.co is blocked somewhere. Must start with https://
# VITE_PROXY_URL=https://handpicked-proxy.YOURNAME.workers.dev

# Optional: domain for the synthetic login email (default handpicked.invalid)
# VITE_AUTH_EMAIL_DOMAIN=handpicked.invalid

# GitHub Pages only (set by the workflow): /<repo-name>/
VITE_BASE=/
